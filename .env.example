# Copy to .env and fill in values before running docker compose

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=centuryroad
POSTGRES_USER=centuryroad
POSTGRES_PASSWORD=centuryroad

# ── JWT ───────────────────────────────────────
# Must be at least 32 characters for HS256
JWT_SECRET=change-me-to-a-random-secret-32chars

# ── Grafana ───────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
