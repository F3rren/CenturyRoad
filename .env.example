# ═══════════════════════════════════════════════════════════════════════════════
# Century Road – environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=centuryroad
POSTGRES_USER=centuryroad
POSTGRES_PASSWORD=change-me                        # required

# ── Spring Boot DataSource ────────────────────────────────────────────────────
# In Docker Compose these are derived from the Postgres vars above.
# For local development (without Docker), set them explicitly:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/centuryroad
SPRING_DATASOURCE_USERNAME=centuryroad
SPRING_DATASOURCE_PASSWORD=change-me               # must match POSTGRES_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-min-32-chars  # required, min 32 chars for HS256
JWT_EXPIRATION_MS=86400000                            # 24 h in milliseconds

# ── Service ports (only needed running outside Docker; Compose sets these itself) ──
# Inside the containers the services always listen on 8080/8081: Caddy and Prometheus
# are wired to those, and nothing outside the Compose network can reach them anyway.
AUTH_PORT=8081
GATEWAY_PORT=8080

# ── Published host ports ──────────────────────────────────────────────────────
# What the machine running Compose listens on. The defaults are the ones dev uses; on
# the production host, pick your own. Only the host side moves - the containers do not.
#
# Prometheus and Grafana are bound to the host's loopback (127.0.0.1) and are reached
# from elsewhere through an SSH tunnel, never directly - see README.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# The proxy is the only public entry. Leave these at 80/443 unless a router or firewall
# forwards the public 80/443 to them: the certificate challenge arrives on 80/443
# whatever is set here, and a domain that cannot be reached there gets no certificate.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ── First administrator (bootstrap) ───────────────────────────────────────────
# Set BOTH only for the very first start against an empty database: creating a user
# requires an admin token, so without this there is no way to get the first one in.
# The mechanism is inert on a database that already has users. Clear both and restart
# once you have logged in - see README, "First administrator".
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Wikipedia (history-service) ───────────────────────────────────────────────
# Wikimedia's User-Agent policy asks every client to say who can be reached if it misbehaves,
# and blocks those that do not "without notice". A URL is enough - this repository's page is
# a good choice, and holds no personal data. An address works too. No default on purpose:
# history-service refuses to start without one.
WIKIMEDIA_CONTACT=https://github.com/F3rren/century-road-backend        # required

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me                         # required

# ── Image versions ────────────────────────────────────────────────────────────
PROMETHEUS_VERSION=v2.53.0
GRAFANA_VERSION=11.1.0

# ── Reverse proxy / TLS ───────────────────────────────────────────────────────
# Only read when the stack is started with: docker compose --profile proxy up -d
# PUBLIC_DOMAIN must already resolve to the host, or Caddy cannot obtain a certificate.
PUBLIC_DOMAIN=centuryroad.example                   # required with --profile proxy
# Seconds a browser will refuse plain HTTP for this host. Kept low on purpose while
# HTTPS is new: raise to 31536000 (one year) once it has been stable for a while.
HSTS_MAX_AGE=300

# ── Frontend ──────────────────────────────────────────────────────────────────
# The exact origin the frontend is served from - scheme, host and port, no trailing
# slash. Anything not listed here is refused by the browser before reaching the API.
FRONTEND_ORIGIN=http://localhost:5173
